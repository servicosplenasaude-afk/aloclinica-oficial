# Copie para .env.sandbox. O arquivo real é ignorado pelo Git.
VITE_APP_ENV=sandbox
VITE_APP_URL=https://sandbox.aloclinica.com.br

# Obrigatórios: projeto Supabase exclusivo do sandbox.
# O aplicativo bloqueia a inicialização se estes valores estiverem ausentes
# ou se VITE_SUPABASE_URL apontar para o projeto de produção.
VITE_SUPABASE_URL=https://SEU_PROJETO_SANDBOX.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICA_SANDBOX

# Integrações exclusivamente de teste/sandbox.
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-SUA-CHAVE-PUBLICA
VITE_VAPID_PUBLIC_KEY=
VITE_MIROTALK_URL=https://meet-sandbox.telemedicinaaloclinica.sbs
VITE_WHATSAPP_GATEWAY_URL=
VITE_COMPREFACE_URL=
VITE_SENTRY_DSN=
